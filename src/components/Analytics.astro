---
// Google tag (gtag.js) for GA4 — property "Armour Crete", stream 15122762097.
//
// The measurement ID is not a secret; it ships in the page source of every
// GA-tagged site on the web, so it lives here rather than in a Vercel env var.
// PUBLIC_GA_ID overrides it if we ever need to point a build at a different
// property.
//
// Gated on PROD so `npm run dev` never sends our own traffic to the reports.
// Vercel preview deployments do build as PROD, so preview hits land in the
// property too — worth knowing when a number looks off.
const id = import.meta.env.PUBLIC_GA_ID || 'G-MYHF4YMJ3Y';
const enabled = import.meta.env.PROD && Boolean(id);
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${id}');`}
      />
    </>
  )
}
