  <script is:inline>
    // Reveal on scroll
    (function () {
      var els = document.querySelectorAll('.rv');
      if (!('IntersectionObserver' in window)) {
        els.forEach(function (e) { e.classList.add('in'); });
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              io.unobserve(en.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      els.forEach(function (e, i) {
        e.style.transitionDelay = (i % 6) * 60 + 'ms';
        io.observe(e);
      });
    })();

    // Nav condenses once you leave the hero
    (function () {
      var nav = document.querySelector('.nav');
      var onScroll = function () {
        nav.classList.toggle('stuck', window.scrollY > 40);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    })();

    // Real submission. Posts to FormSubmit's AJAX endpoint, which forwards to
    // evans@armour-crete.com. No account, no key — but the FIRST submission
    // sends an activation link to that inbox that has to be clicked once.
    // If the network call fails we fall back to opening the mail client so a
    // lead is never silently swallowed.
    (function () {
      var f = document.getElementById('acform');
      if (!f) return;

      var ENDPOINT = 'https://formsubmit.co/ajax/evans@armour-crete.com';
      var btn = f.querySelector('button[type=submit]');
      var status = f.querySelector('.f-status');
      var sending = false;

      function say(msg, kind) {
        status.textContent = msg;
        status.className = 'f-status' + (kind ? ' is-' + kind : '');
      }

      function mailtoFallback(d) {
        var body = [
          'Name: ' + d.name, 'Phone: ' + d.phone, 'Email: ' + d.email,
          'Property: ' + d.property, 'Surface: ' + d.surface,
          'Address or area: ' + d.where, '', d.notes,
        ].join('\n');
        window.location.href =
          'mailto:evans@armour-crete.com?subject=' +
          encodeURIComponent('Assessment request — ' + d.name) +
          '&body=' + encodeURIComponent(body);
      }

      f.addEventListener('submit', function (ev) {
        ev.preventDefault();
        if (sending) return;

        if (!f.reportValidity()) return;

        var fd = new FormData(f);
        var d = {};
        fd.forEach(function (v, k) { d[k] = (v || '').toString().trim(); });

        // honeypot: bots fill hidden fields, people do not
        if (d._honey) return;
        delete d._honey;

        d._subject = 'Assessment request — ' + (d.name || 'no name');
        d._template = 'table';
        d._captcha = 'false';

        sending = true;
        btn.disabled = true;
        var label = btn.textContent;
        btn.textContent = 'Sending…';
        say('');

        fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(d),
        })
          .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) {
            if (!res.ok || String(res.j.success) === 'false') throw new Error('rejected');
            f.reset();
            say('Thank you — that came through. We will call you to arrange the visit.', 'ok');
          })
          .catch(function () {
            say('That did not send. Opening your email instead — or call 435·994·5235.', 'err');
            mailtoFallback(d);
          })
          .then(function () {
            sending = false;
            btn.disabled = false;
            btn.textContent = label;
          });
      });
    })();
  </script>

  <style>
