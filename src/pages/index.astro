---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';

const services = [
  {
    n: '01',
    t: 'Concrete sealing',
    d: 'Driveways, patios, walkways and garage floors — protected against UV, salt and staining.',
    href: '/driveway-sealing',
  },
  {
    n: '02',
    t: 'Decorative & wet-look',
    d: 'Colour-enhanced finishes that deepen the surface and hold it there.',
    href: '/wet-look-concrete-sealing',
  },
  {
    n: '03',
    t: 'Pool decks & salt',
    d: 'Salt-resistant systems for pool surrounds and the slabs that live next to them.',
    href: '/pool-deck-sealing',
  },
  {
    n: '04',
    t: 'Foundation waterproofing',
    d: 'Below-grade protection for new construction, scheduled to your build calendar.',
    href: '/foundation-waterproofing',
  },
  {
    n: '05',
    t: 'Damp proofing',
    d: 'Moisture control on foundation walls before backfill goes in.',
    href: '/foundation-waterproofing',
  },
  {
    n: '06',
    t: 'Crack repair & restoration',
    d: 'Filling, patching and surface correction — before any sealer goes down.',
  },
  {
    n: '07',
    t: 'Expansion joints',
    d: 'Failed joint filler lets water straight down into the sub-base. We cut the old material out, clean the channel and re-fill it so the slab can move without letting anything in.',
    href: '/expansion-joint-replacement',
  },
  {
    n: '08',
    t: 'Asphalt & blacktop sealing',
    d: 'Sealed and conditioned with a natural-oil product containing no asphalt and no tar — old blacktop is restored rather than painted over.',
    href: '/asphalt-sealing',
  },
];

// Area chips that have a dedicated city page link out to it.
const cityLinks = {
  Washington: '/concrete-sealing-washington-ut',
  Hurricane: '/concrete-sealing-hurricane-ut',
  Ivins: '/concrete-sealing-ivins-ut',
  'Santa Clara': '/concrete-sealing-santa-clara-ut',
};

const steps = [
  { n: '01', t: 'Clean', d: 'The slab gets cleaned end to end. Nothing goes down over dirt.' },
  { n: '02', t: 'Dry', d: 'We wait for it to dry completely. Sealer over moisture is how finishes fail.' },
  { n: '03', t: 'Seal', d: 'Deco product, matched to the surface and the exposure it lives in.' },
  { n: '04', t: 'Cure', d: 'Twenty-four hours before you walk or drive on it. Then it is yours again.' },
];

const products = [
  'DECO 20 Clear Finish',
  'Salt Shield 303',
  'SilaCast BES',
  'Shine-A-Cast',
  'TravaCast',
  'Bio Blacktop',
];

const areas = [
  'St. George', 'Kayenta', 'Entrada', 'Ivins', 'Santa Clara', 'Snow Canyon',
  'SunRiver', 'Coral Canyon', 'Green Springs', 'Bloomington', 'Washington', 'Hurricane',
];

const SITE = 'https://www.armour-crete.com';

// FAQ answers are pulled straight from the rendered copy so the structured
// data can never drift from what a visitor actually reads — Google treats a
// mismatch as a violation.
const faq = [
  ['How long before I can walk or drive on it?',
   'Twenty-four hours. Plan for one day without the surface.'],
  ['How often does concrete sealing need doing again?',
   'It depends more on which product is on it than on elapsed time. Penetrating sealers such as DECO 20, Salt Shield 303 and SilaCast soak into the slab and last considerably longer. Topical finishes sit on the surface as a film, and films wear, so they come round more often. Exposure matters too — a shaded patio and a west-facing driveway do not wear at the same rate.'],
  ['Will a concrete sealer make the surface slippery?',
   'Not with the product used on pool decks. Salt Shield 303 is a penetrating sealer that dries clear with no film, and the manufacturer states it does not change the skid or slip resistance of the surface. High-shine finishes do leave a surface layer, so those are discussed at the assessment.'],
  ['Will sealing change the colour of my concrete?',
   'That depends on the finish. A clear sealer protects without changing much. Wet-look and decorative finishes deliberately deepen colour and lift the aggregate. We show you the difference on your own concrete first.'],
  ['Can you seal brand-new concrete?',
   'Not immediately. Fresh concrete has to cure and give up its moisture first. If you are mid build, talk to us at the pour and we will schedule it properly.'],
  ['What about pool decks and salt damage?',
   'Salt Shield 303 is made for it. Salt dissolves in water, soaks into the pores, then crystallises as the water evaporates, and crystals growing inside a confined pore push hard enough to break the surface from the inside. Water-softener discharge does the same to the slab it drains onto.'],
  ['Do you work with builders on new construction?',
   'Yes. Foundation waterproofing and damp proofing are scheduled to the build calendar, plus HOA, commercial and municipal flatwork.'],
  ['Do you work outside St. George?',
   'We are based in St. George and most work is in Washington County — Kayenta, Entrada, Ivins, Santa Clara, Snow Canyon, SunRiver, Coral Canyon, Washington and Hurricane. We are available statewide.'],
  ['What does concrete sealing cost?',
   'It depends on the surface, its condition, the prep needed and the finish you want. The on-site assessment is free and carries no obligation.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': SITE + '/#business',
      name: 'Armour Crete',
      description:
        'Concrete sealing, decorative and wet-look finishes, pool deck salt protection, expansion joints, asphalt sealing and foundation waterproofing in St. George and Washington County, Utah.',
      url: SITE,
      telephone: '+1-435-994-5235',
      email: 'evans@armour-crete.com',
      image: SITE + '/og.png',
      logo: SITE + '/logo.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'St. George',
        addressRegion: 'UT',
        addressCountry: 'US',
      },
      areaServed: [
        ...areas.map((a) => ({ '@type': 'City', name: a + ', UT' })),
        { '@type': 'State', name: 'Utah' },
      ],
      knowsAbout: [
        'concrete sealing', 'driveway sealing', 'pool deck sealing',
        'foundation waterproofing', 'damp proofing', 'expansion joint repair',
        'paver sealing', 'travertine sealing', 'asphalt sealing',
        'decorative concrete', 'wet look sealer', 'salt damage', 'concrete spalling',
      ],
      sameAs: ['https://g.page/r/CTRFIPJaX9QCEAI'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Concrete protection services',
        itemListElement: services.map((sv) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: sv.t,
            description: sv.d,
            ...(sv.href ? { url: SITE + sv.href } : {}),
          },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': SITE + '/#website',
      url: SITE,
      name: 'Armour Crete',
      publisher: { '@id': SITE + '/#business' },
      inLanguage: 'en-US',
    },
    {
      '@type': 'FAQPage',
      '@id': SITE + '/#faq',
      mainEntity: faq.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Base
  title="Concrete Sealing St. George, UT | Driveway Sealer | Armour Crete"
  description="Concrete sealing, wet-look finishes, pool deck salt protection, expansion joints and foundation waterproofing in St. George and Washington County, Utah. Certified Deco applicator. Free on-site assessment."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <a class="skip-link" href="#top">Skip to content</a>
  <SiteNav />

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow rv">St. George · Kayenta · Entrada · Ivins · Snow Canyon</p>
        <h1 class="display hero-h rv">Sealed against<br />the desert.</h1>
        <div class="hero-rule rv"></div>

        <div class="hero-grid">
          <div class="rv">
            <p class="lede">
              Concrete sealing, decorative finishes and foundation waterproofing for
              homes and builders across southern Utah.
            </p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="#assessment">Request an assessment</a>
              <a class="btn btn-quiet" href="#process">How it works</a>
            </div>
            <p class="hero-note">Licensed &amp; insured · Certified Deco applicator · Free on-site assessment</p>
          </div>

          <dl class="facts rv">
            <div><dt class="num">24h</dt><dd>Before you walk or drive on it</dd></div>
            <div><dt class="num">6</dt><dd>Deco product lines, nothing else</dd></div>
            <div><dt class="num">All</dt><dd>Of Utah, based in St. George</dd></div>
            <div><dt class="num">✓</dt><dd>Certified Deco applicator</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section id="services" class="sec">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Concrete services · St. George, Utah</p>
          <h2 class="display sec-h">Every way concrete fails here.<br />We handle all of them.</h2>
        </div>

        <ul class="svc">
          {services.map((s) => (
            <li class="svc-i rv">
              <span class="num svc-n">{s.n}</span>
              <h3 class="svc-t">
                {s.href ? <a href={s.href}>{s.t}<span class="svc-go" aria-hidden="true"> →</span></a> : s.t}
              </h3>
              <p class="svc-d">{s.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ WHY ============ -->
    <section id="why" class="sec">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Why concrete fails in southern Utah</p>
          <h2 class="display sec-h">Concrete does not crack<br />because it is weak.</h2>
        </div>

        <ol class="mech">
          <li class="mech-i rv">
            <span class="num mech-n">01</span>
            <h3 class="mech-t">It moves.</h3>
            <p class="mech-d">
              Concrete expands and contracts with temperature — roughly 5.5 millionths
              of an inch, per inch, per degree Fahrenheit. Swing a 50-foot driveway
              100°F between a January night and a July afternoon and that is about a
              third of an inch of movement. The slab is pinned by the ground under it
              and whatever it butts against, so the movement turns into stress, and
              stress opens hairline cracks. Control joints exist to choose where.
            </p>
          </li>
          <li class="mech-i rv">
            <span class="num mech-n">02</span>
            <h3 class="mech-t">It drinks.</h3>
            <p class="mech-d">
              Concrete is porous. Water wicks into the capillary pores and down into
              every crack the movement just opened — and it carries whatever is
              dissolved in it. Salt off the pool. Salt out of the softener. Salt
              already in the soil and the hard water it came from.
            </p>
          </li>
          <li class="mech-i rv">
            <span class="num mech-n">03</span>
            <h3 class="mech-t">Then it breaks from the inside.</h3>
            <p class="mech-d">
              Water expands about nine percent when it freezes, and southern Utah
              nights do drop below freezing. A saturated pore has nowhere to put
              that. Salt does the same job without needing the cold — as water
              evaporates the salt crystallises, and crystals growing inside a
              confined pore push hard enough to lift the surface off. Scaling,
              spalling, and the white bloom of efflorescence are all the same story.
            </p>
          </li>
        </ol>

        <aside class="claim rv">
          <p class="claim-k display">Sealing does not stop concrete moving.</p>
          <p class="claim-d">
            Nothing does. What it stops is water being there to take advantage of the
            movement. Keep the pore network from staying saturated and you starve both
            freeze–thaw and salt crystallisation of the one thing they need. Movement
            on its own is just movement.
          </p>
        </aside>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section id="process" class="sec sec-dark">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow eyebrow-lt">Our concrete sealing process</p>
          <h2 class="display sec-h">Four steps. No shortcuts<br />in any of them.</h2>
        </div>

        <ol class="steps">
          {steps.map((s) => (
            <li class="step rv">
              <span class="num step-n">{s.n}</span>
              <h3 class="step-t">{s.t}</h3>
              <p class="step-d">{s.d}</p>
            </li>
          ))}
        </ol>

        <aside class="cure rv">
          <p class="cure-k display"><span class="num">24</span> hours</p>
          <p class="cure-d">
            That is the honest answer to the question everyone actually asks — how long
            am I without my driveway. One day. We would rather tell you up front than
            have you find out on the way to work.
          </p>
        </aside>
      </div>
    </section>

    <!-- ============ MATERIALS ============ -->
    <section id="materials" class="sec">
      <div class="wrap mat-in">
        <div class="mat-copy rv">
          <p class="eyebrow">Materials</p>
          <h2 class="display sec-h">We only use<br />Deco products.</h2>
          <p class="lede">
            Deco Products has manufactured in Denver since 1991, water-based and
            solvent-free from the start. We are a certified Deco applicator — which is
            what lets us put down the restricted products, including the ICC-approved
            foundation membrane. No house-brand substitutions, no whatever was on the
            truck.
          </p>
          <a class="path-link mat-link" href="/products">What each one does →</a>
        </div>

        <ul class="prods rv">
          {products.map((p) => (
            <li class="prod"><span class="num">{p}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ MAINTENANCE ============ -->
    <section id="care" class="sec sec-dark">
      <div class="wrap care-in">
        <div class="care-copy rv">
          <p class="eyebrow eyebrow-lt">Concrete sealing maintenance</p>
          <h2 class="display sec-h">We come back<br />every two years.</h2>
          <p class="lede lede-lt">
            Sealer is not permanent. It wears where you drive on it and weathers where
            the sun hits it, and most people only notice once the surface has already
            started to go — by which point the fix is bigger than a reseal.
          </p>
          <p class="lede lede-lt">
            So we offer a standing arrangement instead. We come back on a two-year
            cycle, clean it, and put a fresh coat down. You do not book it and you do
            not think about it, and the slab never gets far enough gone to need
            restoring. Where a product genuinely lasts longer than that, we will tell
            you and set the cycle to match it.
          </p>
          <a class="btn btn-send" href="#assessment">Ask about the maintenance program</a>
        </div>

        <ul class="care-list rv">
          <li><span class="num">01</span> Scheduled by us, on a two-year cycle</li>
          <li><span class="num">02</span> Same product, same finish, no surprises</li>
          <li><span class="num">03</span> Priority on the calendar</li>
          <li><span class="num">04</span> Stop whenever you like</li>
        </ul>
      </div>
    </section>

    <!-- ============ TWO PATHS ============ -->
    <section class="sec sec-tight">
      <div class="wrap paths">
        <article class="path rv">
          <p class="eyebrow">Homeowners</p>
          <h3 class="path-t display">Driveways, patios,<br />pool decks.</h3>
          <p class="path-d">
            A private assessment on site, a clear scope, and a finish chosen for how your
            property actually gets used.
          </p>
          <a class="path-link" href="#assessment">Request an assessment →</a>
        </article>

        <article class="path rv">
          <p class="eyebrow">Builders &amp; commercial</p>
          <h3 class="path-t display">Waterproofing,<br />on your calendar.</h3>
          <p class="path-d">
            Foundation waterproofing and damp proofing for new construction, plus HOA,
            commercial and municipal flatwork. We work to the build schedule.
          </p>
          <a class="path-link" href="/products">Foundation waterproofing materials →</a>
        </article>
      </div>
    </section>

    <!-- ============ SERVICE AREA ============ -->
    <section id="area" class="sec">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Concrete sealing service area</p>
          <h2 class="display sec-h">Based in St. George.<br />Available statewide.</h2>
        </div>
        <ul class="areas rv">
          {areas.map((a) => (
            <li>{cityLinks[a] ? <a href={cityLinks[a]}>{a}</a> : a}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="faq" class="sec">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Concrete sealing questions</p>
          <h2 class="display sec-h">The things people<br />actually ask.</h2>
        </div>

        <div class="faq rv">
          <details class="qa">
            <summary>How long before I can walk or drive on it?</summary>
            <div class="qa-b"><p>
              Twenty-four hours. That is the real number, and we would rather you had it
              up front than found out on the way to work. Plan for one day without the
              surface and you will not be caught out.
            </p></div>
          </details>

          <details class="qa">
            <summary>How often does it need doing again?</summary>
            <div class="qa-b"><p>
              It depends on the product and how hard the surface gets used — a shaded
              patio and a west-facing driveway do not wear at anything like the same
              rate. Our maintenance program runs on a two-year cycle, and if you would
              rather just call us when it looks tired, that is fine too.
            </p>
            </div>
          </details>

          <details class="qa">
            <summary>Will it make the surface slippery?</summary>
            <div class="qa-b"><p>
              Not with the product we use on pool decks. Salt Shield 303 is a penetrating
              sealer — it soaks into the concrete and dries clear with no film on top —
              and the manufacturer states plainly that it does not change the skid or
              slip resistance of the surface.
            </p>
            <p>
              The high-shine finishes are a different conversation, because those do leave
              a layer on the surface. If you want a wet look somewhere that gets walked on
              barefoot and wet, say so at the assessment and we will talk it through
              rather than just quoting it.
            </p></div>
          </details>

          <details class="qa">
            <summary>Will it change the colour?</summary>
            <div class="qa-b"><p>
              That depends which finish you choose, and it is a decision rather than a
              side effect. A clear sealer protects without changing much. Wet-look and
              decorative finishes deliberately deepen the colour and lift the aggregate
              — that is the entire point of them. We will show you the difference on
              your own concrete before anything is committed to.
            </p></div>
          </details>

          <details class="qa">
            <summary>Can you seal brand-new concrete?</summary>
            <div class="qa-b"><p>
              Not immediately. Fresh concrete has to cure and give up its moisture
              first, and sealing over that is how finishes fail early. If you are mid
              build, talk to us at the pour and we will schedule it properly.
            </p>
            </div>
          </details>

          <details class="qa">
            <summary>What about my pool deck and the salt?</summary>
            <div class="qa-b"><p>
              Salt Shield 303 exists for exactly this. Salt dissolves in water, soaks
              into the pores, then crystallises as the water evaporates — and crystals
              growing inside a confined pore push hard enough to break the surface from
              the inside. Softener discharge does the same thing to the slab it drains
              onto.
            </p></div>
          </details>

          <details class="qa">
            <summary>Do you work with builders?</summary>
            <div class="qa-b"><p>
              Yes. Foundation waterproofing and damp proofing on new construction get
              scheduled to the build calendar rather than ours, plus HOA, commercial and
              municipal flatwork.
            </p></div>
          </details>

          <details class="qa">
            <summary>Do you work outside St. George?</summary>
            <div class="qa-b"><p>
              We are based in St. George and most of our work is in Washington County —
              Kayenta, Entrada, Ivins, Santa Clara, Snow Canyon, SunRiver, Coral Canyon,
              Washington and Hurricane. We are available statewide.
            </p></div>
          </details>

          <details class="qa">
            <summary>What does it cost?</summary>
            <div class="qa-b"><p>
              It depends on the surface, its condition, how much prep it needs and the
              finish you want, so any number quoted before someone has looked at it is a
              guess. The on-site assessment is free and there is no obligation attached
              to it.
            </p></div>
          </details>
        </div>
      </div>
    </section>

    <!-- ============ ASSESSMENT ============ -->
    <section id="assessment" class="sec sec-dark">
      <div class="wrap ass-in">
        <div class="ass-copy rv">
          <p class="eyebrow eyebrow-lt">Get started</p>
          <h2 class="display sec-h">Request an<br />assessment.</h2>
          <p class="lede lede-lt">
            We come out, look at the surface, and tell you what it needs. No charge for
            the visit.
          </p>

          <dl class="ass-contact">
            <div><dt>Dylan Evans</dt><dd><a class="num" href="tel:+14359945235">435·994·5235</a></dd></div>
            <div><dt>Zac Evans</dt><dd><a class="num" href="tel:+14352246987">435·224·6987</a></dd></div>
            <div><dt>Email</dt><dd><a href="mailto:evans@armour-crete.com">evans@armour-crete.com</a></dd></div>
          </dl>
        </div>

        <form class="ass-form rv" id="acform">
          <div class="f-row">
            <label class="fld"><span>Name</span><input name="name" type="text" autocomplete="name" required /></label>
            <label class="fld"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <label class="fld"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <div class="f-row">
            <label class="fld">
              <span>Property</span>
              <select name="property">
                <option>Home</option>
                <option>New construction</option>
                <option>Commercial or HOA</option>
                <option>Municipal</option>
              </select>
            </label>
            <label class="fld">
              <span>Surface</span>
              <select name="surface">
                <option>Driveway</option>
                <option>Patio or walkway</option>
                <option>Pool deck</option>
                <option>Garage or basement floor</option>
                <option>Foundation</option>
                <option>Not sure yet</option>
              </select>
            </label>
          </div>
          <label class="fld"><span>Address or area</span><input name="where" type="text" autocomplete="street-address" /></label>
          <label class="fld"><span>Anything we should know</span><textarea name="notes" rows="3"></textarea></label>
          <input type="text" name="_honey" class="f-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn-send" type="submit">Send request</button>
          <p class="f-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-brand">
        <img src="/logo.png" alt="Armour Crete — concrete sealing and foundation protection, St. George, Utah" width="800" height="800" loading="lazy" />
        <p class="foot-tag">Concrete &amp; foundation protection · Southern Utah</p>
      </div>

      <div class="foot-cols">
        <div>
          <p class="eyebrow eyebrow-lt">Services</p>
          <a href="/driveway-sealing">Driveway sealing</a>
          <a href="/pool-deck-sealing">Pool deck sealing</a>
          <a href="/wet-look-concrete-sealing">Wet-look &amp; decorative</a>
          <a href="/expansion-joint-replacement">Expansion joints</a>
          <a href="/asphalt-sealing">Asphalt &amp; blacktop</a>
          <a href="/foundation-waterproofing">Foundation waterproofing</a>
        </div>
        <div>
          <p class="eyebrow eyebrow-lt">Service area</p>
          <span>St. George</span>
          <a href="/concrete-sealing-washington-ut">Washington</a>
          <a href="/concrete-sealing-hurricane-ut">Hurricane</a>
          <a href="/concrete-sealing-ivins-ut">Ivins</a>
          <a href="/concrete-sealing-santa-clara-ut">Santa Clara</a>
        </div>
        <div>
          <p class="eyebrow eyebrow-lt">Contact</p>
          <a class="num" href="tel:+14359945235">435·994·5235</a>
          <a class="num" href="tel:+14352246987">435·224·6987</a>
          <a href="mailto:evans@armour-crete.com">evans@armour-crete.com</a>
        </div>
        <div>
          <p class="eyebrow eyebrow-lt">Company</p>
          <span>Licensed &amp; insured</span>
          <span>Certified Deco applicator</span>
          <span>Deco products only</span>
          <span>Free on-site assessment</span>
        </div>
      </div>
